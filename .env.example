# Google GenAI API Key (required)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=your_api_key_here

# Google Drive Service Account Credentials (required for sync)
# This should be the full JSON content from your service account key file
# Set this as a GitHub secret for automated syncing
GOOGLE_DRIVE_CREDENTIALS={"type":"service_account","project_id":"your-project",...}

# GitHub Personal Access Token (required for story submission API)
# To create a token:
# 1. Go to https://github.com/settings/tokens
# 2. Click "Generate new token" > "Generate new token (classic)"
# 3. Give it a name like "RuffTree Story Submission"
# 4. Select scope: "public_repo" (or "repo" if using private repo)
# 5. Generate and copy the token
# 6. Add it to your Vercel project environment variables
GITHUB_TOKEN=your_github_token_here
