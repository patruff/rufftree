  "_instructions": {
    "format": "This file contains a flat list of all family members with relationship IDs. Edit this to update the expandable family tree.",
    "fields": {
      "id": "Unique identifier (string)",
      "name": "Full name of the person",
      "dob": "Date of birth in YYYY format",
      "dod": "Date of death in YYYY format, or 'alive' if still living",
      "occupation": "Optional occupation/job title",
      "phone": "Optional phone number",
      "maidenName": "Optional maiden name for married women",
      "notes": "Optional notes or interesting facts",
      "spouseId": "ID of spouse, or null if no spouse",
      "parentIds": "Array of parent IDs (usually 2, can be 0-2)",
      "siblingIds": "Array of sibling IDs",
      "childrenIds": "Array of children IDs",
      "generation": "Generation label (e.g., 'Millennial', 'Baby Boomer', 'Generation Z')",
      "from_pat": "Integer showing generations from Patrick Ruff (Millennial = 0, Gen X = -1, Gen Z = +1, etc.)",
      "ethnicity": "Optional: Object mapping countries to percentages (must sum to 100). Calculated from parents if not manually set.",
      "home_city": "Optional: String for city where person lives/lived (e.g., 'Philadelphia')",
      "home_state": "Optional: String for state where person lives/lived (e.g., 'Pennsylvania' or 'PA')",
      "causeOfDeath": "Optional: String for deceased individuals indicating what they died from (e.g., 'heart-attack', 'pancreatic-cancer')",
      "health_condition": "Optional: Array of strings for ongoing/chronic health conditions (e.g., ['diabetes', 'heart-disease']). Applies to both living and deceased.",
      "cemetery_name": "Optional: String for deceased individuals indicating cemetery name (e.g., 'Oak Hill Cemetery')",
      "cemetery_city": "Optional: String for deceased individuals indicating cemetery city (e.g., 'Philadelphia')",
      "cemetery_state": "Optional: String for deceased individuals indicating cemetery state (e.g., 'Pennsylvania' or 'PA')",
      "heritable_risk": "Optional: Object mapping health conditions to risk levels (low/moderate/high/very-high). Auto-calculated from parents' health conditions and causes of death.",
      "heritable_traits": "Optional: Object mapping trait names to genotype/phenotype info. Auto-calculated from parents for Mendelian traits (eye color, hair texture, dimples, etc.)",
      "gender": "String: 'male' or 'female'. Auto-inferred from name if not specified.",
      "final_male": "Boolean: True if this male is the last male descendant in his Y chromosome (paternal) line. Auto-calculated.",
      "final_female": "Boolean: True if this female is the last female descendant in her mitochondrial DNA (maternal) line. Auto-calculated."
    },
    "expandable_tree": {
      "description": "The tree starts with the person specified in 'startPerson'. Clicking a node expands to show their spouse, siblings, and parents. Clicking parents shows their siblings and parents, etc.",
      "start_person": "Set 'startPerson' to the ID of the person to start the tree with (e.g., 'patrick')"
    },
    "tips": [
      "All IDs must be unique strings",
      "Use null for spouseId if person has no spouse",
      "Empty arrays [] for parentIds, siblingIds, or childrenIds if none exist",
      "Relationships should be bidirectional (if A is parent of B, B should be in A's childrenIds)",
      "Use 'alive' for dod if the person is still living",
      "Years should be 4 digits (YYYY format)",
      "Optional fields: occupation, phone, maidenName, notes - add as needed"
    ]
  }
