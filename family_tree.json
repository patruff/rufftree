      "phone": "Optional phone number",
      "maidenName": "Optional maiden name for married women",
      "spouseId": "ID of spouse, or null if no spouse",
      "parentIds": "Array of parent IDs (usually 2, can be 0-2)",
      "siblingIds": "Array of sibling IDs",
      "childrenIds": "Array of children IDs"
    },
    "expandable_tree": {
      "description": "The tree starts with the person specified in 'startPerson'. Clicking a node expands to show their spouse, siblings, and parents. Clicking parents shows their siblings and parents, etc.",
      "start_person": "Set 'startPerson' to the ID of the person to start the tree with (e.g., 'patrick')"
    },
    "tips": [
      "All IDs must be unique strings",
      "Use null for spouseId if person has no spouse",
      "Empty arrays [] for parentIds, siblingIds, or childrenIds if none exist",
      "Relationships should be bidirectional (if A is parent of B, B should be in A's childrenIds)",
      "Use 'alive' for dod if the person is still living",
      "Years should be 4 digits (YYYY format)",
      "Optional fields: occupation, phone, maidenName - add as needed"
    ]
  }
